## Neutral cross-thread layouts. Runtime owners and callbacks never live here.

import interop
from luce_server.internal.body import Body
from luce_server.internal.response_data import Data
from luce_server.internal.routes import Table
from luce_server.internal.storage import Buffer
import net
import process
import sync
import thread

pub struct Config:
    pub var network_threads: usize = 8
    pub var request_timeout_ms: u64 = 30000
    pub var idle_timeout_ms: u64 = 5000
    pub var response_timeout_ms: u64 = 30000
    pub var application_timeout_ms: u64 = 30000
    pub var body_limit: usize = 67108864
    pub var memory_body_limit: usize = 65536
    pub var response_limit: usize = 1048576
    pub var requests_per_connection: usize = 100
    pub var raw_socket: bool
    pub var shutdown_timeout_ms: u64 = 5000

pub struct Lifecycle:
    pub var draining: @bool
    pub var drain_until: u64
    pub var termination: process.TerminationStatus?
    pub var join_lock: sync.Mutex
    pub var started: @bool
    pub var joined: bool
    pub var threads: thread.Handle[65]
    pub var thread_count: usize
    pub var applications: (interop.Worker[str, unit, unit]?)[32]
    pub var application_count: usize

pub struct Dispatch:
    pub var lock: sync.Mutex
    pub var ready: sync.Condition
    pub var changed: sync.Condition
    pub var queue: Exchange*?[64]
    pub var queue_head: usize
    pub var queue_count: usize
    pub var waiting: usize

pub struct Counters:
    pub var accepted: @u64
    pub var completed: @u64
    pub var failures: @u64
    pub var active: @u64
    pub var outstanding: @u64

pub struct State:
    pub var references: @u64
    pub var config: Config
    pub var temporary_directory: str
    pub var table: Table
    pub var listener: net.Listener
    pub var cancellation: sync.Cancellation
    pub var lifecycle: Lifecycle
    pub var dispatch: Dispatch
    pub var counters: Counters

pub enum WorkKind as u8:
    http = 0
    websocket = 1
    tcp = 2

pub struct Exchange:
    pub var references: @u64
    pub var owner: State*
    pub var kind: WorkKind
    pub var session_connection: net.Connection*?
    pub var session_input: void*?
    pub var claimed: bool
    pub var request: RequestData*?
    ## Protected by owner.dispatch.lock. Response storage becomes immutable at done=true.
    pub var done: bool
    pub var abandoned: bool
    pub var expired: bool

    pub func http() -> RequestData*:
        return self.request else trap("TCP exchange has no HTTP request")

pub struct RequestData:
    pub var wire: Buffer
    pub var path_buffer: Buffer
    pub var scratch: Buffer
    pub var loaded: Buffer
    pub var fields: net.HttpField[100]
    pub var head: net.HttpHead
    pub var path: str
    pub var route_index: usize
    pub var payload: Body
    pub var reply: Data
