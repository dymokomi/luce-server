## Response storage is assembled by one application owner, then committed under
## the server lock. Network threads observe immutable bytes after commitment.
import c
import files
import io
import net
import strings
import paths
import luce_server.internal.model
import luce_server.internal.storage

pub func field(request: model.Pending*, name: str, value: str) -> !:
    if name.length == 0:
        error(storage.invalid, "a response field needs a name")
    for byte in name.bytes:
        var valid = (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z') or (byte >= '0' and byte <= '9')
        for allowed in "!#$%&'*+-.^_`|~".bytes:
            if byte == allowed:
                valid = true
        if not valid:
            error(storage.invalid, "invalid response field name")
    for byte in value.bytes:
        if byte == 127 or (byte < 32 and byte != '\t'):
            error(storage.invalid, "invalid response field value")
    if net.http_equal(name, "content-length") or net.http_equal(name, "transfer-encoding") or net.http_equal(name, "connection") or net.http_equal(name, "content-type"):
        error(storage.invalid, "the server owns response framing and content type")
    var line: u8[8192]
    var writer = io.SliceWriter.over(line)
    try io.write_all(&writer, name.bytes)
    try io.write_all(&writer, ": ".bytes)
    try io.write_all(&writer, value.bytes)
    try io.write_all(&writer, "\r\n".bytes)
    try request.response_headers.append(writer.written())

pub func content(request: model.Pending*, status: i64, content_type: str, data: const u8[]) -> !:
    if status < 200 or status > 599:
        error(storage.invalid, "application response status must be between 200 and 599")
    if (status == 204 or status == 304) and data.length != 0:
        error(storage.invalid, "this response status cannot carry a body")
    for byte in content_type.bytes:
        if byte < 32 or byte >= 127:
            error(storage.invalid, "invalid response content type")
    request.response.clear()
    request.response_type.clear()
    request.response_file.destroy()
    request.response_is_file = false
    try request.response_type.append(content_type.bytes)
    try request.response.append(data)
    request.response_status = (u16)status

pub func file(request: model.Pending*, path: str, content_type: str) -> !:
    if strings.contains(path, "\0"):
        error(storage.invalid, "a file path contains NUL")
    let parent = try storage.copy(paths.directory(path))
    defer storage.release(parent)
    let leaf = try storage.copy(paths.base(path))
    defer storage.release(leaf)
    var directory = try files.Directory.open((c.str)parent)
    defer directory.destroy()
    var opened = try directory.open_file((c.str)leaf, follow_symlinks = false, nonblocking = true)
    errdefer opened.destroy()
    let info = try opened.metadata()
    if info.kind != files.FileKind.regular or info.size < 0:
        error(storage.invalid, "a response file must be a regular file")
    try content(request, 200, content_type, "".bytes)
    request.response_file.destroy()
    request.response_file = opened
    request.response_file_length = (u64)info.size
    request.response_is_file = true

pub func send(destination: io.Writer, request: model.Pending*, keep_alive: bool) -> !:
    var fields: net.HttpField[100]
    var count: usize = 0
    if request.response_type.used > 0:
        fields[count] = net.HttpField(name = "Content-Type", value = (str)request.response_type.view())
        count += 1
    let extra = (str)request.response_headers.view()
    var at: usize = 0
    while at < extra.length:
        let start = at
        while at < extra.length and extra.bytes[at] != ':':
            at += 1
        let name = (str)extra.bytes[start..<at]
        at += 2
        let value_start = at
        while at + 1 < extra.length and extra.bytes[at] != '\r':
            at += 1
        if count == 98:
            error(storage.limit, "too many response fields")
        fields[count] = net.HttpField(name = name, value = (str)extra.bytes[value_start..<at])
        count += 1
        at += 2
    let length = request.response_file_length if request.response_is_file else (u64)request.response.used
    let no_body = request.response_status == 204 or request.response_status == 304
    var head_buffer: u8[16384]
    let encoded = try net.http_encode_head(head_buffer, net.HttpHead(method = request.head.method, version = request.head.version,
        status = request.response_status, fields = fields[..<count], body_kind = net.HttpBodyKind.empty if no_body else net.HttpBodyKind.fixed,
        body_length = length, keep_alive = keep_alive))
    try io.write_all(destination, encoded)
    if request.head.method == "HEAD" or no_body:
        return
    var writer = try net.HttpBodyWriter.over(destination, net.HttpBodyKind.fixed, length)
    if request.response_is_file:
        var block: u8[32768]
        var remaining = length
        while remaining > 0:
            let amount = (usize)remaining if remaining < (u64)block.length else block.length
            let read = try request.response_file.read(block[..<amount])
            if read == 0:
                error(io.unexpected_eof, "response file was truncated during transfer")
            discard(try writer.write(block[..<read]))
            remaining -= (u64)read
    else:
        discard(try writer.write(request.response.view()))
    try writer.finish()
