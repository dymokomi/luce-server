## WebSocket endpoints share an HTTP listener. Opening events allow the
## application to approve Origin/identity and choose an offered subprotocol.
## The Base network pool handles framing, masking, fragments and ping/pong.
import luce_server.http

pub func route(server: http.Server, pattern: str, identifier: i64) -> !:
    try http.websocket_route(server, pattern, identifier)

pub func accept(request: http.Request, protocol: str) -> !:
    try http.accept_websocket(request, protocol)

pub func send(request: http.Request, data: const u8[]) -> !:
    try http.send_message(request, data)
