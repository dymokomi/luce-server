## HTTP application objects. Protocol machinery and runtime workers belong to
## the library; handlers receive a scoped Request and return an owned Response.

import luce_std.files
import body
import config
import internal.application_pool
import internal.storage
import request
import response
import route
import router
import server
import static_root

pub type ServerConfig = config.ServerConfig
pub type Statistics = config.Statistics
pub type Server = server.Server
pub type Router = router.Router
pub type Route = route.Route
pub type Handler = route.Handler
pub type Application = application_pool.Application
pub type Request = request.Request
pub type Response = response.Response
pub type Body = body.Body
pub type StaticRoot = static_root.StaticRoot

pub let invalid_request: ErrorCode = storage.invalid
pub let limit_exceeded: ErrorCode = storage.limit
pub let request_closed: ErrorCode = storage.closed
pub let invalid_state: ErrorCode = storage.conflict
pub let file_missing: ErrorCode = files.missing
pub let file_exists: ErrorCode = files.already_exists
