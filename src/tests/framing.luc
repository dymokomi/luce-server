import server.http.chunked
import server.http.encode
import server.response
from server.content import Content
from server.headers import Headers

class Stream: Content:
    var position: int = 0

    pub func length(self) -> int?:
        return none

    pub func read(self, maximum: int) -> bytes!:
        self.position += 1
        return b"abc" if self.position == 1 else b""

    pub func close(self):
        self.position = 2

func decode_chunks(input: bytes, fragment: int) -> bytes!:
    let decoder = chunked.Decoder(100)
    var result = b""
    var offset = 0
    while offset < input.length and not decoder.finished():
        let count = fragment if fragment < input.length - offset else input.length - offset
        let step = try decoder.consume(input[offset..<offset + count])
        assert(step.consumed > 0)
        offset += step.consumed
        result = result + step.data
    try decoder.finish()
    assert(input[offset..] == b"next")
    assert(decoder.trailers.get("x-check") == "yes")
    return result

func invalid_chunk(input: bytes) -> bool:
    let decoder = chunked.Decoder(100)
    var at = 0
    while at < input.length:
        let step = decoder.consume(input[at..]) catch failure:
            return true
        at += step.consumed
        if step.finished:
            break
    discard(decoder.finish() catch failure:
        return true)
    return false

pub func run() -> unit!:
    let encoded = b"3;name=\"x;y\"\r\nabc\r\n2\r\nde\r\n0\r\nX-Check: yes\r\n\r\nnext"
    for fragment in 1..=encoded.length:
        assert(try decode_chunks(encoded, fragment) == b"abcde")
    for invalid in [b"", b"1\nX\n0\n\n", b"+1\r\nx\r\n0\r\n\r\n", b" 1\r\nx\r\n0\r\n\r\n",
                    b"1 \r\nx\r\n0\r\n\r\n", b"1\r\nx!0\r\n\r\n", b"1\r\nx\r\n0\r\nContent-Length: 1\r\n\r\n",
                    b"ffffffffffffffff\r\n", b"1;x=\"oops\r\nx\r\n0\r\n\r\n", b"1\r\nx\r\n0\r\n"]:
        assert(invalid_chunk(invalid))
    let fixed = try encode.Encoder(try response.text("hello"), "GET", "HTTP/1.1", true)
    assert((try (try fixed.next()).text()).contains("content-length: 5\r\n"))
    assert(try fixed.next() == b"hello")
    assert(try fixed.next() == b"")
    let head = try encode.Encoder(try response.text("hello"), "HEAD", "HTTP/1.1", true)
    assert((try (try head.next()).text()).contains("content-length: 5\r\n"))
    assert(try head.next() == b"")
    let stream = try encode.Encoder(try response.Response(200, Stream(), Headers()), "GET", "HTTP/1.1", true)
    assert((try (try stream.next()).text()).contains("transfer-encoding: chunked\r\n"))
    assert(try stream.next() == b"3\r\nabc\r\n")
    assert(try stream.next() == b"0\r\n\r\n")
    assert(try stream.next() == b"")
    print("ok framing: all chunk fragment sizes, trailers, invalid input, fixed/chunked output and HEAD")
