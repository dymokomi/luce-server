from server.routing import Router
from server.request import Request
from server.response import Response
from server.content import MemoryContent, read_all
import server.response
import server.http.head

func item(request: Request) -> Response!:
    let number = try request.path_int("item_id")
    let limit = try request.query_int("limit", default = 10, minimum = 1, maximum = 100)
    return try response.text(f"item {number}, limit {limit}")

func special(request: Request) -> Response!:
    return try response.text("special")

func make_request(method: str, path: str) -> Request!:
    let parsed = try head.parse((method + " " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n").bytes())
    return try Request(parsed, MemoryContent(b""))

pub func run() -> unit!:
    let router = Router()
    try router.add("GET", "/items/{item_id:int}", item)
    try router.add("GET", "/items/special", special)
    let result = try router.dispatch(try make_request("GET", "/items/42?limit=2"))
    assert(result.status == 200)
    assert(try read_all(result.content, 100) == b"item 42, limit 2")
    assert((try router.dispatch(try make_request("GET", "/items/special"))).status == 200)
    assert((try router.dispatch(try make_request("GET", "/items/not-an-int"))).status == 422)
    assert((try router.dispatch(try make_request("GET", "/items/42?limit=0"))).status == 422)
    assert((try router.dispatch(try make_request("GET", "/items/42?limit=1&limit=2"))).status == 422)
    assert((try router.dispatch(try make_request("POST", "/items/42"))).status == 405)
    assert((try router.dispatch(try make_request("HEAD", "/items/42"))).status == 200)
    let options = try router.dispatch(try make_request("OPTIONS", "/items/42"))
    assert(options.status == 204 and options.headers.get("allow") == "GET, HEAD, OPTIONS")
    assert((try router.dispatch(try make_request("GET", "/missing"))).status == 404)
    var duplicate = false
    discard(router.add("GET", "/items/{other:int}", item) catch failure:
        duplicate = true
        recover ())
    assert(duplicate)
    print("ok routing: precedence, parameters, validation, HEAD, OPTIONS, 404 and 405")
