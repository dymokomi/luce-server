## Coordinates native Luce workers. A run identifier crosses by value; each
## worker constructs its own Application and calls Application.serve_worker.
## The coordinator owns signals and outlives every worker task.
from server.options import Options
import server.options
import server.base.network
import server.base.system

pub class Coordinator:
    let run: network.Run
    let configuration: Options
    var closed: bool = false

    pub func init(self, configuration: Options) -> unit!:
        try options.validate(configuration)
        self.run = try network.begin(configuration.host, configuration.port, configuration.max_connections, configuration.workers)
        self.configuration = configuration
        if configuration.signal_handlers:
            discard(system.install_handlers() catch failure:
                self.run.close()
                error(failure.code, failure.message))

    pub func identifier(self) -> int:
        return network.identifier(self.run)

    ## Announce only after every worker has opened its application and completed
    ## startup hooks. False means startup was interrupted; still wait all tasks.
    pub func ready(self) -> bool!:
        while not network.all_ready(self.run):
            if network.run_stopped(self.run) or (self.configuration.signal_handlers and system.stopping()):
                self.stop()
                return false
            network.pause()
        if self.configuration.announce:
            print(f"listening http://{self.configuration.host}:{try network.port(self.run)}")
        return true

    pub func stop(self):
        if not self.closed:
            network.stop(network.identifier(self.run))

    pub func close(self):
        if not self.closed:
            self.closed = true
            self.run.close()
            if self.configuration.signal_handlers:
                system.restore_handlers()

    func deinit(self):
        if not self.closed:
            self.run.close()
            if self.configuration.signal_handlers:
                system.restore_handlers()

## A failing worker stops its siblings before unwinding and joining its children.
pub func stop(run: int):
    network.stop(run)
