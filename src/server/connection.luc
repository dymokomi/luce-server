## One connection's HTTP state. No socket read occurs while response output is
## pending; this bounds pipelined input and gives writes natural backpressure.
from server.handler import Handler
from server.request import Request
from server.options import Options
from server.upload import UploadBody
from server.http.head import RequestHead, Limits
from server.http.encode import Encoder
from server.errors import bad_request, limit_exceeded, unsupported_protocol
import server.http.head
import server.http.syntax
import server.http.chunked
import server.http.date
import server.response
import server.base.network

pub class Connection:
    pub let socket: network.Connection
    let options: Options
    var input: bytes = b""
    var scanned: int = 0
    var request_head: RequestHead? = none
    var body: UploadBody? = none
    var chunks: chunked.Decoder? = none
    var remaining: int = 0
    var encoder: Encoder? = none
    var pending: bytes = b""
    var sent: int = 0
    var close_after: bool = false
    var requests: int = 0
    var started_at: int = 0
    var body_started_at: int = 0
    var last_activity: int
    pub var closed: bool = false

    pub func init(self, socket: network.Connection, options: Options):
        self.socket = socket
        self.options = options
        self.last_activity = network.now_milliseconds()

    pub func writing(self) -> bool:
        return self.pending.length > self.sent or self.encoder != none

    pub func idle(self) -> bool:
        return self.input.length == 0 and self.request_head == none and not self.writing()

    pub func close(self):
        if not self.closed:
            self.closed = true
            if let encoder = self.encoder:
                encoder.close()
            if let body = self.body:
                body.close()
            self.encoder = none
            self.body = none
            self.input = b""
            self.pending = b""
            self.socket.close()

    pub func timed_out(self, now: int) -> bool:
        if self.writing():
            return now - self.last_activity >= self.options.write_timeout_ms
        if self.request_head != none:
            return now - self.body_started_at >= self.options.body_timeout_ms or now - self.last_activity >= self.options.idle_timeout_ms
        if self.started_at > 0:
            return now - self.started_at >= self.options.header_timeout_ms
        return now - self.last_activity >= self.options.idle_timeout_ms

    pub func service(self, handler: Handler, draining: bool) -> unit!:
        if self.closed:
            return
        if self.writing():
            try self.write_output(handler, draining)
            return
        let received = try network.receive(self.socket)
        if received.length > 0:
            self.last_activity = network.now_milliseconds()
            if self.started_at == 0:
                self.started_at = self.last_activity
            self.input = self.input + received
            try self.advance(handler, draining)
        if network.ended(self.socket) and not self.writing():
            self.close()

    func advance(self, handler: Handler, draining: bool) -> unit!:
        if self.request_head == none:
            let found = syntax.header_end(self.input, self.scanned - 3)
            if found == none:
                self.scanned = self.input.length
                if self.input.length > 32768:
                    try self.fail(431, "request headers exceed the configured limit")
                return
            let end = found else error(bad_request, "header boundary is missing")
            let parsed = head.parse(self.input[..<end], Limits(body_bytes = self.options.max_body_bytes)) catch failure:
                let status = 413 if failure.code == limit_exceeded else (501 if failure.code == unsupported_protocol else 400)
                try self.fail(status, failure.message)
                return
            self.input = self.input[end..]
            self.request_head = parsed
            self.body = UploadBody(self.options.max_body_bytes, self.options.temporary_directory)
            self.body_started_at = network.now_milliseconds()
            self.remaining = 0
            match parsed.framing:
                .empty: self.remaining = 0
                .fixed(length): self.remaining = length
                .chunked: self.chunks = chunked.Decoder(self.options.max_body_bytes)
            if parsed.expect_continue and (self.remaining > 0 or self.chunks != none):
                self.pending = b"HTTP/1.1 100 Continue\r\n\r\n"
                self.sent = 0
        let body = self.body else error(bad_request, "request body state is missing")
        if let decoder = self.chunks:
            while self.input.length > 0 and not decoder.finished():
                let step = decoder.consume(self.input) catch failure:
                    try self.fail(413 if failure.code == limit_exceeded else 400, failure.message)
                    return
                self.input = self.input[step.consumed..]
                try body.append(step.data)
            if not decoder.finished():
                return
        else:
            let count = self.remaining if self.remaining < self.input.length else self.input.length
            if count > 0:
                try body.append(self.input[..<count])
                self.input = self.input[count..]
                self.remaining -= count
            if self.remaining > 0:
                return
        try body.finish()
        let metadata = self.request_head else error(bad_request, "request headers are missing")
        let request = Request(metadata, body) catch failure:
            try self.fail(400, failure.message)
            return
        let result = handler.handle(request) catch failure:
            try self.fail(500, "the application could not complete the request")
            return
        self.requests += 1
        let keep_alive = metadata.keep_alive and not draining and self.requests < self.options.max_requests_per_connection
        self.encoder = try Encoder(result, metadata.method, metadata.version, keep_alive, date.now())

    pub func fail(self, status: int, message: str) -> unit!:
        if self.encoder != none:
            self.close()
            return
        self.pending = b""
        self.sent = 0
        self.close_after = true
        self.encoder = try Encoder(try response.problem(status, "request_error", message), "GET", "HTTP/1.1", false, date.now())

    func write_output(self, handler: Handler, draining: bool) -> unit!:
        if self.sent == self.pending.length:
            self.pending = b""
            self.sent = 0
            if let encoder = self.encoder:
                self.pending = try encoder.next()
                if self.pending.length == 0:
                    let close_after = self.close_after or encoder.close_after or draining or network.ended(self.socket)
                    encoder.close()
                    self.encoder = none
                    if let body = self.body:
                        body.close()
                    self.body = none
                    self.request_head = none
                    self.chunks = none
                    self.scanned = 0
                    self.started_at = 0
                    if close_after:
                        self.close()
                        return
                    if self.input.length > 0:
                        self.started_at = network.now_milliseconds()
                        try self.advance(handler, draining)
                    return
            elif self.input.length > 0:
                try self.advance(handler, draining)
                return
        if self.pending.length > self.sent:
            let count = try network.send(self.socket, self.pending[self.sent..])
            self.sent += count
            if count > 0:
                self.last_activity = network.now_milliseconds()
