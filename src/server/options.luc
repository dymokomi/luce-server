from server.errors import invalid_configuration

pub struct Options:
    pub let host: str = "127.0.0.1"
    pub let port: int = 8000
    ## Each worker owns at most this many simultaneous connections.
    pub let max_connections: int = 32
    pub let workers: int = 4
    pub let max_requests_per_connection: int = 1000
    pub let max_body_bytes: int = 1073741824
    pub let header_timeout_ms: int = 10000
    pub let idle_timeout_ms: int = 30000
    pub let body_timeout_ms: int = 300000
    pub let write_timeout_ms: int = 30000
    pub let shutdown_timeout_ms: int = 5000
    pub let temporary_directory: str = "/tmp"
    pub let signal_handlers: bool = true
    pub let announce: bool = true

pub func validate(options: Options) -> unit!:
    if options.workers < 1 or options.workers > 32:
        error(invalid_configuration, "worker count must be between one and 32")
    if options.port < 0 or options.port > 65535 or options.max_connections < 1 or options.max_connections > 65535:
        error(invalid_configuration, "invalid listening port or connection limit")
    if options.max_requests_per_connection < 1 or options.max_body_bytes < 0:
        error(invalid_configuration, "request count must be positive and body limit nonnegative")
    for timeout in [options.header_timeout_ms, options.idle_timeout_ms, options.body_timeout_ms, options.write_timeout_ms, options.shutdown_timeout_ms]:
        if timeout < 1 or timeout > 86400000:
            error(invalid_configuration, "timeouts must be between one millisecond and one day")
