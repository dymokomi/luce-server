## A bounded readiness loop. Application callbacks are synchronous; network
## progress is interleaved across connections, one output chunk per ready turn.
from server.handler import Handler
from server.options import Options
from server.connection import Connection
import server.options
import server.base.network
import server.base.system

pub func serve(handler: Handler, configuration: Options) -> unit!:
    try options.validate(configuration)
    let loop = try network.listen(configuration.host, configuration.port, configuration.max_connections)
    if configuration.signal_handlers:
        try system.install_handlers()
    var connections: map[int, Connection] = {}
    if configuration.announce:
        print(f"listening http://{configuration.host}:{try network.port(loop)}")
    discard(run_loop(loop, handler, configuration, connections) catch failure:
        for (slot, connection) in connections:
            discard(network.disable(loop, slot) catch cleanup_failure:
                recover ())
            connection.close()
        if configuration.signal_handlers:
            system.restore_handlers()
        error(failure.code, failure.message))
    if configuration.signal_handlers:
        system.restore_handlers()
    loop.close()

func run_loop(loop: network.Loop, handler: Handler, configuration: Options, connections: map[int, Connection]) -> unit!:
    var draining = false
    var shutdown_at = 0
    while true:
        let now = network.now_milliseconds()
        if configuration.signal_handlers and system.stopping() and not draining:
            draining = true
            shutdown_at = now + configuration.shutdown_timeout_ms
            try network.stop_accepting(loop)
        if draining and connections.length == 0:
            break
        try network.wait_ready(loop, 50)
        if not draining and (try network.ready(loop, 0)):
            # A full connection table leaves pending accepts in the bounded OS
            # backlog; active clients continue to make progress before another poll.
            for slot in 1..=configuration.max_connections:
                if slot in connections:
                    continue
                let socket = try network.accept(loop) else break
                let connection = Connection(socket, configuration)
                connections[slot] = connection
                try network.watch(loop, slot, socket, false)
        for slot in connections.keys():
            let connection = connections[slot] else continue
            if (draining and (connection.idle() or now >= shutdown_at)) or connection.timed_out(now):
                try network.disable(loop, slot)
                connection.close()
            elif try network.ready(loop, slot):
                discard(connection.service(handler, draining) catch failure:
                    discard(network.disable(loop, slot) catch cleanup_failure:
                        recover ())
                    connection.close()
                    recover ())
            if connection.closed:
                try network.disable(loop, slot)
                discard(connections.remove(slot))
            else:
                try network.watch(loop, slot, connection.socket, connection.writing())
        try network.watch_listener(loop, not draining and connections.length < configuration.max_connections)
