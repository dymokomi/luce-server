## Incremental chunk framing. The caller receives body slices and a consumed byte
## count; bytes after the final trailer remain available for the next request.
from server.errors import bad_request, limit_exceeded
from server.encoding import hex_digit, latin1
from server.headers import Headers
from server.http.syntax import token, trim_ows

pub struct Step:
    pub let consumed: int
    pub let data: bytes
    pub let finished: bool

enum State:
    size
    data
    delimiter
    trailers
    done
    failed

pub class Decoder:
    let maximum: int
    var total: int = 0
    var chunks: int = 0
    var remaining: int = 0
    var state: State = State.size
    var line: bytes = b""
    var carriage: bool = false
    var trailer_bytes: int = 0
    pub let trailers: Headers

    pub func init(self, maximum: int):
        self.maximum = maximum
        self.trailers = Headers()

    func chunk_size(self, line: bytes) -> int!:
        if line.length == 0 or hex_digit(line[0]) == none:
            error(bad_request, "chunk size must begin with a hexadecimal digit")
        let text = latin1(line)
        let semicolon = text.index_of(";") else text.length
        if semicolon == text.length and trim_ows(text) != text:
            error(bad_request, "whitespace after chunk size needs an extension")
        let size = trim_ows(text[..<semicolon]).bytes()
        if size.length == 0:
            error(bad_request, "empty chunk size")
        var value = 0
        for byte in size:
            let digit = hex_digit(byte) else error(bad_request, "invalid hexadecimal chunk size")
            let available = self.maximum - self.total
            if value > available // 16 or (value == available // 16 and digit > available % 16):
                error(limit_exceeded, "chunked request body exceeds its limit")
            value = value * 16 + digit
        if semicolon < text.length:
            try self.extensions(text[semicolon..])
        return value

    func extensions(self, text: str) -> unit!:
        # Extensions have no application meaning here, but malformed quoting or
        # control characters cannot be accepted as an alternate framing grammar.
        var at = 0
        while at < text.length:
            while at < text.length and (text[at..<at + 1] == " " or text[at..<at + 1] == "\t"):
                at += 1
            if at == text.length or text[at..<at + 1] != ";":
                error(bad_request, "invalid chunk extension")
            at += 1
            while at < text.length and (text[at..<at + 1] == " " or text[at..<at + 1] == "\t"):
                at += 1
            let start = at
            while at < text.length and token(text[at..<at + 1]):
                at += 1
            if at == start:
                error(bad_request, "chunk extension needs a token name")
            while at < text.length and (text[at..<at + 1] == " " or text[at..<at + 1] == "\t"):
                at += 1
            if at < text.length and text[at..<at + 1] == "=":
                at += 1
                while at < text.length and (text[at..<at + 1] == " " or text[at..<at + 1] == "\t"):
                    at += 1
                if at < text.length and text[at..<at + 1] == "\"":
                    at += 1
                    var closed = false
                    while at < text.length:
                        let character = text[at..<at + 1]
                        at += 1
                        if character == "\"":
                            closed = true
                            break
                        if character == "\\":
                            if at == text.length:
                                error(bad_request, "incomplete quoted chunk extension")
                            let escaped = text[at..<at + 1].bytes()[0]
                            if (escaped < 32 and escaped != 9) or escaped == 127:
                                error(bad_request, "invalid quoted chunk extension")
                            at += 1
                        else:
                            let byte = character.bytes()[0]
                            if (byte < 32 and byte != 9) or byte == 127:
                                error(bad_request, "invalid quoted chunk extension")
                    if not closed:
                        error(bad_request, "unclosed quoted chunk extension")
                else:
                    let value_start = at
                    while at < text.length and token(text[at..<at + 1]):
                        at += 1
                    if value_start == at:
                        error(bad_request, "chunk extension needs a token value")

    func trailer(self, line: bytes) -> unit!:
        self.trailer_bytes += line.length + 2
        if self.trailer_bytes > 32768 or self.trailers.count() >= 100:
            error(limit_exceeded, "chunk trailers exceed their limit")
        let text = latin1(line)
        let colon = text.index_of(":") else error(bad_request, "invalid trailer field")
        let name = text[..<colon].lower()
        if name == "content-length" or name == "transfer-encoding" or name == "host" or name == "connection" or name == "trailer" or name == "authorization" or name == "content-type" or name == "content-encoding":
            error(bad_request, "request control fields cannot appear in trailers")
        try self.trailers.add(name, trim_ows(text[colon + 1..]))

    pub func consume(self, input: bytes) -> Step!:
        if self.state == State.failed:
            error(bad_request, "chunk decoder has already failed")
        return self.consume_bytes(input) catch failure:
            self.state = State.failed
            error(failure.code, failure.message)

    func consume_bytes(self, input: bytes) -> Step!:
        var at = 0
        while at < input.length and self.state != State.done:
            if self.state == State.data:
                let available = input.length - at
                let count = self.remaining if self.remaining < available else available
                let data = input[at..<at + count]
                self.remaining -= count
                self.total += count
                if self.remaining == 0:
                    self.state = State.delimiter
                    self.carriage = false
                return Step(consumed = at + count, data = data, finished = false)
            let byte = input[at]
            at += 1
            if self.carriage:
                if byte != 10:
                    error(bad_request, "chunk line requires CRLF")
                self.carriage = false
                if self.state == State.delimiter:
                    self.state = State.size
                elif self.state == State.size:
                    self.remaining = try self.chunk_size(self.line)
                    self.line = b""
                    self.chunks += 1
                    if self.chunks > 1000000:
                        error(limit_exceeded, "too many request chunks")
                    self.state = State.trailers if self.remaining == 0 else State.data
                else:
                    if self.line.length == 0:
                        self.state = State.done
                    else:
                        try self.trailer(self.line)
                    self.line = b""
            elif byte == 13:
                self.carriage = true
            elif byte == 10 or self.state == State.delimiter:
                error(bad_request, "invalid chunk delimiter")
            else:
                if self.line.length >= 8192:
                    error(limit_exceeded, "chunk line exceeds its limit")
                self.line = self.line + input[at - 1..<at]
        return Step(consumed = at, data = b"", finished = self.state == State.done)

    pub func finished(self) -> bool:
        return self.state == State.done

    pub func finish(self) -> unit!:
        if self.state != State.done:
            error(bad_request, "truncated chunked request body")
