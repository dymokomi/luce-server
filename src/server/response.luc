## Response values contain content and application headers. The HTTP encoder is
## the only component that chooses wire framing and suppresses bodyless responses.
from server.content import Content, MemoryContent
from server.headers import Headers
from server.errors import invalid_response
from server.json.value import Value
import server.json.encode

pub class Response:
    pub let status: int
    pub let headers: Headers
    pub let content: Content

    pub func init(self, status: int, content: Content, headers: Headers) -> unit!:
        if status < 200 or status > 599:
            error(invalid_response, "application response status must be between 200 and 599")
        self.status = status
        self.content = content
        self.headers = headers

pub func binary(data: bytes, media_type: str = "application/octet-stream", status: int = 200) -> Response!:
    let headers = Headers()
    try headers.add("content-type", media_type)
    return try Response(status, MemoryContent(data), headers)

pub func text(value: str, status: int = 200) -> Response!:
    return try binary(value.bytes(), "text/plain; charset=utf-8", status)

pub func html(value: str, status: int = 200) -> Response!:
    return try binary(value.bytes(), "text/html; charset=utf-8", status)

pub func json(value: Value, status: int = 200) -> Response!:
    return try binary((try encode.compact(value)).bytes(), "application/json", status)

pub func redirect(location: str, status: int = 307) -> Response!:
    if status != 301 and status != 302 and status != 303 and status != 307 and status != 308:
        error(invalid_response, "invalid redirect status")
    let headers = Headers()
    try headers.add("location", location)
    return try Response(status, MemoryContent(b""), headers)

pub func problem(status: int, kind: str, message: str) -> Response!:
    return try json(Value.object(fields = {"error": Value.object(fields = {
        "type": Value.text(value = kind), "message": Value.text(value = message)
    })}), status)
