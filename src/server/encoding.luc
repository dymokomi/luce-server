## HTTP field values preserve octets through a Latin-1 view. URI/JSON decoding
## uses UTF-8 separately; neither operation guesses the other's encoding.
from server.errors import bad_request

let octets: bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"
let upper_latin: str = " ¡¢£¤¥¦§¨©ª«¬­®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ"

pub func byte(value: int) -> bytes:
    assert(value >= 0 and value <= 255)
    return octets[value..<value + 1]

pub func latin1(data: bytes) -> str:
    var pieces: list[str] = []
    var start = 0
    var at = 0
    while at < data.length:
        if data[at] >= 128:
            if at > start:
                pieces.append(data[start..<at].text() catch failure:
                    trap("ASCII run is not UTF-8"))
            let offset = data[at] - 128
            pieces.append(upper_latin[offset..<offset + 1])
            start = at + 1
        at += 1
    if start < at:
        pieces.append(data[start..<at].text() catch failure:
            trap("ASCII run is not UTF-8"))
    return pieces.join("")

pub func hex_digit(value: int) -> int?:
    if value >= 48 and value <= 57:
        return value - 48
    if value >= 65 and value <= 70:
        return value - 55
    if value >= 97 and value <= 102:
        return value - 87
    return none

## Encode one validated Unicode scalar. JSON's surrogate-pair decoder calls this
## only after combining the pair; surrogate code points alone are not scalars.
pub func scalar(value: int) -> str!:
    if value < 0 or value > 1114111 or (value >= 55296 and value <= 57343):
        error(bad_request, "invalid Unicode scalar")
    var encoded = b""
    if value < 128:
        encoded = byte(value)
    elif value < 2048:
        encoded = byte(192 + value // 64) + byte(128 + value % 64)
    elif value < 65536:
        encoded = byte(224 + value // 4096) + byte(128 + (value // 64) % 64) + byte(128 + value % 64)
    else:
        encoded = byte(240 + value // 262144) + byte(128 + (value // 4096) % 64) + byte(128 + (value // 64) % 64) + byte(128 + value % 64)
    return try encoded.text()

## Decode escapes once. A plus means space only in form/query components.
pub func percent_decode(text: str, plus_as_space: bool = false) -> str!:
    let data = text.bytes()
    var output = b""
    var at = 0
    var start = 0
    while at < data.length:
        if data[at] == 37 or (plus_as_space and data[at] == 43):
            output = output + data[start..<at]
            if data[at] == 43:
                output = output + b" "
                at += 1
            else:
                if at + 2 >= data.length:
                    error(bad_request, "incomplete percent escape")
                let high = hex_digit(data[at + 1]) else error(bad_request, "invalid percent escape")
                let low = hex_digit(data[at + 2]) else error(bad_request, "invalid percent escape")
                output = output + byte(high * 16 + low)
                at += 3
            start = at
        else:
            at += 1
    output = output + data[start..]
    return output.text() catch failure:
        error(bad_request, "URL component is not UTF-8")
