## Mounts retain a directory identity. Each request opens validated components
## relative to that handle, so renaming the configured path cannot redirect it.
from server.request import Request
from server.response import Response
from server.content import Content, MemoryContent
from server.headers import Headers
from server.errors import invalid_configuration
import server.base.filesystem
import server.response
import server.http.date
import server.static.conditions
import server.static.ranges
import server.static.mime

class FileContent: Content:
    let file: filesystem.File
    let count: int
    var remaining: int
    var closed: bool = false

    func init(self, file: filesystem.File, start: int, count: int) -> unit!:
        try filesystem.seek_file(file, start)
        self.file = file
        self.count = count
        self.remaining = count

    pub func length(self) -> int?:
        return self.count

    pub func read(self, maximum: int) -> bytes!:
        if self.closed or self.remaining == 0:
            return b""
        var count = maximum if maximum < self.remaining else self.remaining
        if count > 16384:
            count = 16384
        let result = try filesystem.read_file(self.file, count)
        self.remaining -= result.length
        return result

    pub func close(self):
        if not self.closed:
            self.closed = true
            self.file.close()

pub class Mount:
    pub let prefix: str
    let root: filesystem.Directory
    let index: str

    pub func init(self, prefix: str, directory: str, index: str = "index.html") -> unit!:
        if not prefix.starts_with("/") or (prefix != "/" and prefix.ends_with("/")) or prefix.contains("?") or prefix.contains("#"):
            error(invalid_configuration, "static prefix must be an absolute path without a trailing slash")
        if index == "" or index == "." or index == ".." or index.contains("/") or index.contains("\\"):
            error(invalid_configuration, "static index must be one file name")
        self.prefix = prefix
        self.root = try filesystem.open_directory(directory)
        self.index = index

    pub func matches(self, path: str) -> bool:
        return self.prefix == "/" or path == self.prefix or path.starts_with(self.prefix + "/")

    pub func respond(self, request: Request) -> Response!:
        if request.method != "GET" and request.method != "HEAD":
            let result = try response.problem(405, "method_not_allowed", "static files support GET and HEAD")
            try result.headers.add("allow", "GET, HEAD, OPTIONS")
            if request.method == "OPTIONS":
                return try Response(204, MemoryContent(b""), result.headers)
            return result
        var relative = request.path[1..] if self.prefix == "/" else request.path[self.prefix.length..]
        if relative.starts_with("/"):
            relative = relative[1..]
        if relative == "" or relative.ends_with("/"):
            relative = relative + self.index
        let parts = relative.split("/")
        for part in parts:
            if part == "" or part == "." or part == ".." or part.contains("\\"):
                return try response.problem(403, "invalid_path", "path is outside the static mount")
        return self.open_response(request, parts) catch failure:
            if failure.code == filesystem.not_found:
                return try response.problem(404, "not_found", "static file was not found")
            if failure.code == filesystem.access_denied or failure.code == filesystem.invalid_path or failure.code == filesystem.not_a_file:
                return try response.problem(403, "access_denied", "static path is not accessible")
            error(failure.code, failure.message)

    func open_response(self, request: Request, parts: list[str]) -> Response!:
        var parent = self.root
        for index in 0..<parts.length - 1:
            parent = try filesystem.child_directory(parent, parts[index])
        var filename = parts[parts.length - 1]
        let file = filesystem.open_file(parent, filename) catch failure:
            if failure.code != filesystem.not_a_file:
                error(failure.code, failure.message)
            let directory = try filesystem.child_directory(parent, filename)
            let opened = try filesystem.open_file(directory, self.index)
            if not request.path.ends_with("/"):
                opened.close()
                return try response.redirect(request.path + "/", 307)
            filename = self.index
            recover opened
        let metadata = try filesystem.metadata(file)
        let etag = "W/\"" + metadata.identity + "\""
        let headers = Headers()
        try headers.add("etag", etag)
        try headers.add("accept-ranges", "bytes")
        if let modified = date.format(metadata.modified_seconds):
            try headers.add("last-modified", modified)
        let status = conditions.status(request.headers, etag, metadata.modified_seconds)
        if status != 200:
            file.close()
            return try Response(status, MemoryContent(b""), headers)
        try headers.add("content-type", mime.for_path(filename))
        if request.method == "GET" and conditions.allow_range(request.headers, metadata.modified_seconds):
            if let field = request.headers.get("range"):
                match ranges.select(field, metadata.size):
                    .partial(first, last):
                        try headers.add("content-range", f"bytes {first}-{last}/{metadata.size}")
                        return try Response(206, try FileContent(file, first, last - first + 1), headers)
                    .unsatisfiable:
                        file.close()
                        try headers.add("content-range", f"bytes */{metadata.size}")
                        return try Response(416, MemoryContent(b""), headers)
                    .full: discard(0)
        return try Response(200, try FileContent(file, 0, metadata.size), headers)
