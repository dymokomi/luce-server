## Preconditions run before Range. File metadata yields a weak ETag: it supports
## cache validation but never claims byte-for-byte identity for If-Match/If-Range.
from server.headers import Headers
from server.http.syntax import trim_ows
import server.http.date

func weak_match(field: str, etag: str) -> bool:
    let opaque = etag[2..] if etag.starts_with("W/") else etag
    for part in field.split(","):
        let value = trim_ows(part)
        if value == "*":
            return true
        let candidate = value[2..] if value.starts_with("W/") else value
        if candidate == opaque:
            return true
    return false

pub func status(headers: Headers, etag: str, modified: int) -> int:
    let matches = headers.all("if-match")
    if matches.length > 0:
        # This implementation exposes only weak metadata tags; no explicit tag
        # can satisfy a strong comparison. '*' still matches the existing file.
        if trim_ows(matches.join(",")) != "*":
            return 412
    else:
        if let unmodified = headers.get("if-unmodified-since"):
            if let instant = date.parse(unmodified):
                if modified > instant:
                    return 412
    let none_matches = headers.all("if-none-match")
    if none_matches.length > 0:
        if weak_match(none_matches.join(","), etag):
            return 304
    else:
        if let since = headers.get("if-modified-since"):
            if let instant = date.parse(since):
                if modified <= instant:
                    return 304
    return 200

pub func allow_range(headers: Headers, modified: int) -> bool:
    let condition = headers.get("if-range") else return true
    # An entity tag requires a strong comparison; our metadata tag is weak.
    let instant = date.parse(condition) else return false
    return modified == instant
