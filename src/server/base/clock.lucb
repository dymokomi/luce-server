## UTC calendar conversion at the systems boundary. Formatting and HTTP date
## grammar stay in Luce; these value results own no buffers or OS resources.
import time

extern struct Calendar:
    seconds: i32
    minutes: i32
    hours: i32
    day: i32
    month: i32
    year: i32
    weekday: i32
    year_day: i32
    daylight: i32
    offset: i64
    zone: void*?

extern func gmtime_r(seconds: i64*, calendar: Calendar*) -> Calendar*?
extern func timegm(calendar: Calendar*) -> i64

pub struct Parts:
    pub var year: i64
    pub var month: i64
    pub var day: i64
    pub var hour: i64
    pub var minute: i64
    pub var second: i64
    pub var weekday: i64

pub func unix() -> i64:
    return time.unix()

pub func parts(instant_seconds: i64) -> Parts?:
    var instant = instant_seconds
    var calendar: Calendar
    if gmtime_r(&instant, &calendar) == none:
        return none
    return Parts(year = (i64)calendar.year + 1900, month = (i64)calendar.month + 1,
                 day = calendar.day, hour = calendar.hours, minute = calendar.minutes,
                 second = calendar.seconds, weekday = calendar.weekday)

pub func seconds(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64) -> i64?:
    if year < 0 or year > 9999 or month < 1 or month > 12 or day < 1 or day > 31 or hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 60:
        return none
    # POSIX timestamps have no leap-second slot; map a stated leap second to the
    # preceding second, conservatively avoiding a later conditional timestamp.
    let normalized_second = second if second < 60 else 59
    var calendar = Calendar(year = (i32)year - 1900, month = (i32)month - 1, day = (i32)day,
                            hours = (i32)hour, minutes = (i32)minute, seconds = (i32)normalized_second)
    let result = timegm(&calendar)
    let checked = parts(result) else return none
    if checked.year != year or checked.month != month or checked.day != day or checked.hour != hour or checked.minute != minute or checked.second != normalized_second:
        return none
    return result
