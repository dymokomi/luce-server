## URI decomposition precedes decoding. Escaped question marks and ampersands
## remain component data; only literal delimiters split the request target.
from server.errors import bad_request
from server.encoding import percent_decode

pub struct Parameter:
    pub let name: str
    pub let value: str

pub struct Target:
    pub let path: str
    pub let query: list[Parameter]

pub func parse(raw: str, method: str) -> Target!:
    var origin = raw
    if origin == "*":
        if method != "OPTIONS":
            error(bad_request, "asterisk target is only valid for OPTIONS")
        return Target(path = "*", query = [])
    if origin.starts_with("http://") or origin.starts_with("https://"):
        let prefix = 7 if origin.starts_with("http://") else 8
        let rest = origin[prefix..]
        var end = rest.length
        if let slash = rest.index_of("/"):
            end = slash
        if let query = rest.index_of("?"):
            if query < end:
                end = query
        let authority = rest[..<end]
        if authority == "" or authority.contains("@") or authority.contains("#") or authority.contains("\\"):
            error(bad_request, "invalid authority in absolute request target")
        origin = rest[end..]
        if origin == "" or origin.starts_with("?"):
            origin = "/" + origin
    if not origin.starts_with("/") or origin.contains("#"):
        error(bad_request, "expected an origin or absolute request target")
    var raw_path = origin
    var raw_query = ""
    if let question = origin.index_of("?"):
        raw_path = origin[..<question]
        raw_query = origin[question + 1..]
    let path = try percent_decode(raw_path)
    for byte in path.bytes():
        if byte == 0 or byte == 92 or byte < 32 or byte == 127:
            error(bad_request, "invalid decoded path character")
    var query: list[Parameter] = []
    if raw_query != "":
        for pair in raw_query.split("&"):
            if pair == "":
                continue
            var name = pair
            var value = ""
            if let equals = pair.index_of("="):
                name = pair[..<equals]
                value = pair[equals + 1..]
            query.append(Parameter(name = try percent_decode(name, true), value = try percent_decode(value, true)))
    return Target(path = path, query = query)
