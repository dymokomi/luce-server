## JSON number grammar, shared by decoding and serialization of exact decimals.
pub func digit(value: int) -> bool:
    return value >= 48 and value <= 57

pub func valid(text: str) -> bool:
    let data = text.bytes()
    var at = 0
    if data.length == 0:
        return false
    if data[at] == 45:
        at += 1
    if at == data.length:
        return false
    if data[at] == 48:
        at += 1
    elif data[at] >= 49 and data[at] <= 57:
        while at < data.length and digit(data[at]):
            at += 1
    else:
        return false
    if at < data.length and data[at] == 46:
        at += 1
        let start = at
        while at < data.length and digit(data[at]):
            at += 1
        if start == at:
            return false
    if at < data.length and (data[at] == 101 or data[at] == 69):
        at += 1
        if at < data.length and (data[at] == 43 or data[at] == 45):
            at += 1
        let start = at
        while at < data.length and digit(data[at]):
            at += 1
        if start == at:
            return false
    return at == data.length
