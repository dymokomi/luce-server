## Bounded serialization. Exact decimals are grammar-checked even when callers
## construct Value directly. Depth limits also terminate cyclic collection graphs.
from server.errors import invalid_json, limit_exceeded
from server.json.value import Value
import server.json.number

class Writer:
    let maximum: int
    let depth_limit: int
    var count: int = 0
    var pieces: list[str]

    func init(self, maximum: int, depth_limit: int):
        self.maximum = maximum
        self.depth_limit = depth_limit
        self.pieces = []

    func append(self, text: str) -> unit!:
        if text.byte_count > self.maximum - self.count:
            error(limit_exceeded, "JSON output exceeds its byte limit")
        self.count += text.byte_count
        self.pieces.append(text)

    func quoted(self, text: str) -> unit!:
        try self.append("\"")
        let digits = "0123456789abcdef"
        let data = text.bytes()
        var start = 0
        var at = 0
        while at < data.length:
            let byte = data[at]
            if byte == 34 or byte == 92 or byte < 32:
                try self.append(try data[start..<at].text())
                if byte == 34:
                    try self.append("\\\"")
                elif byte == 92:
                    try self.append("\\\\")
                else:
                    let high = byte // 16
                    let low = byte % 16
                    try self.append("\\u00" + digits[high..<high + 1] + digits[low..<low + 1])
                start = at + 1
            at += 1
        try self.append(try data[start..].text())
        try self.append("\"")

    func value(self, value: Value, depth: int) -> unit!:
        if depth > self.depth_limit:
            error(limit_exceeded, "JSON output exceeds its depth limit")
        match value:
            .null: try self.append("null")
            .boolean(flag): try self.append("true" if flag else "false")
            .integer(amount): try self.append(str(amount))
            .decimal(text):
                if not number.valid(text):
                    error(invalid_json, "invalid exact JSON decimal")
                try self.append(text)
            .text(text): try self.quoted(text)
            .array(items):
                try self.append("[")
                var first = true
                for item in items:
                    if not first:
                        try self.append(",")
                    first = false
                    try self.value(item, depth + 1)
                try self.append("]")
            .object(fields):
                try self.append("{")
                var first = true
                for (key, item) in fields:
                    if not first:
                        try self.append(",")
                    first = false
                    try self.quoted(key)
                    try self.append(":")
                    try self.value(item, depth + 1)
                try self.append("}")

    func result(self) -> str:
        return self.pieces.join("")

pub func compact(value: Value, max_bytes: int = 1048576, max_depth: int = 64) -> str!:
    if max_bytes < 0 or max_depth < 0:
        error(limit_exceeded, "invalid JSON output limits")
    let writer = Writer(max_bytes, max_depth)
    try writer.value(value, 0)
    return writer.result()
