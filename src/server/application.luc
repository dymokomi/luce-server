## Application setup is explicit: handlers, middleware and lifecycle hooks are
## ordinary typed Luce function values. The transport loop only sees Handler.
from server.handler import Handler
from server.request import Request
from server.response import Response
from server.routing import Router
from server.options import Options
from server.errors import invalid_configuration
from server.static.mount import Mount
import server.engine
import server.base.network

pub interface Middleware:
    func before(self, request: Request) -> Response?!
    func after(self, request: Request, response: Response) -> Response!

pub class Application: Handler:
    let router: Router
    var middleware: list[Middleware]
    var startup: list[func() -> unit!]
    var shutdown: list[func() -> unit!]
    var mounts: list[Mount]
    var running: bool = false

    pub func init(self):
        self.router = Router()
        self.middleware = []
        self.startup = []
        self.shutdown = []
        self.mounts = []

    pub func route(self, method: str, path: str, handler: func(Request) -> Response!, summary: str = "") -> unit!:
        if self.running:
            error(invalid_configuration, "routes cannot change while the server is running")
        try self.router.add(method, path, handler, summary)

    pub func get(self, path: str, handler: func(Request) -> Response!, summary: str = "") -> unit!:
        try self.route("GET", path, handler, summary)

    pub func post(self, path: str, handler: func(Request) -> Response!, summary: str = "") -> unit!:
        try self.route("POST", path, handler, summary)

    pub func put(self, path: str, handler: func(Request) -> Response!, summary: str = "") -> unit!:
        try self.route("PUT", path, handler, summary)

    pub func patch(self, path: str, handler: func(Request) -> Response!, summary: str = "") -> unit!:
        try self.route("PATCH", path, handler, summary)

    pub func delete(self, path: str, handler: func(Request) -> Response!, summary: str = "") -> unit!:
        try self.route("DELETE", path, handler, summary)

    pub func use(self, middleware: Middleware) -> unit!:
        if self.running:
            error(invalid_configuration, "middleware cannot change while the server is running")
        self.middleware.append(middleware)

    pub func on_startup(self, hook: func() -> unit!):
        self.startup.append(hook)

    pub func on_shutdown(self, hook: func() -> unit!):
        self.shutdown.append(hook)

    pub func mount(self, prefix: str, directory: str, index: str = "index.html") -> unit!:
        if self.running:
            error(invalid_configuration, "static mounts cannot change while the server is running")
        for existing in self.mounts:
            if existing.prefix == prefix:
                error(invalid_configuration, "duplicate static mount prefix")
        self.mounts.append(try Mount(prefix, directory, index))

    pub func handle(self, request: Request) -> Response!:
        var entered: list[Middleware] = []
        var result: Response? = none
        for layer in self.middleware:
            entered.append(layer)
            if let early = try layer.before(request):
                result = early
                break
        if result == none:
            if self.router.has_path(request.path):
                result = try self.router.dispatch(request)
            else:
                var selected: Mount? = none
                var length = -1
                for mount in self.mounts:
                    if mount.matches(request.path) and mount.prefix.length > length:
                        selected = mount
                        length = mount.prefix.length
                if let mount = selected:
                    result = try mount.respond(request)
                else:
                    result = try self.router.dispatch(request)
        var response = result else error(invalid_configuration, "application produced no response")
        for layer in entered.reversed():
            response = try layer.after(request, response)
        return response

    func finish(self) -> unit!:
        self.running = false
        var failed: str? = none
        for hook in self.shutdown.reversed():
            discard(hook() catch failure:
                if failed == none:
                    failed = failure.message
                recover ())
        if let message = failed:
            error(invalid_configuration, "shutdown hook failed: " + message)

    pub func serve_worker(self, run: int, configuration: Options) -> unit!:
        if self.running:
            error(invalid_configuration, "application is already running")
        self.running = true
        discard(self.start(run, configuration) catch failure:
            discard(self.finish() catch cleanup_failure:
                recover ())
            error(failure.code, failure.message))
        try self.finish()

    func start(self, run: int, configuration: Options) -> unit!:
        for hook in self.startup:
            try hook()
        let loop = try network.attach(run)
        discard(engine.serve(self, configuration, loop) catch failure:
            loop.close()
            error(failure.code, failure.message))
        loop.close()
