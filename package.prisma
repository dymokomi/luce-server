#prisma 4.0
def package "luce-server" {
    str owner = "dymokomi"
    str version = "0.4.0"
    str kind = "package"
    str language = "luce-base"
    str description = "A multithreaded server library written entirely in Luce Base. It provides HTTP routing, REST responses, static content, bounded file transfers, WebSocket sessions and TCP streams."
    str readme = "README.md"
    str[] public = ["http", "socket", "websocket"]

    def dependency "luce-json" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-json"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-std"
    }
}
